[Unit]
Description=SwitchFix — layout convert + LLM-fix selection (EN↔RU)
Documentation=file:///usr/share/doc/switchfix/PRIVACY.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/switchfix daemon
Restart=on-failure
RestartSec=2

# Shared /tmp is required: daemon IPC (llm-history, llm-busy, reload, toggle)
# is read by the Plasma widget and `switchfix` CLI.
PrivateTmp=no
# AF_INET/6: optional LLM API (llm.base_url).
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=switchfix

[Install]
WantedBy=graphical-session.target
