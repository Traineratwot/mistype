[Unit]
Description=SwitchFix — layout convert + LLM-fix selection (EN↔RU)
Documentation=file:///usr/share/doc/switchfix/PRIVACY.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/switchfix daemon
Restart=on-failure
RestartSec=2

# Sandboxing (user service — tight, but keep the paths SwitchFix actually uses).
# Features: selection layout-convert, LLM-fix selection (optional HTTP API),
# tray, hotkeys. No dictionaries, no local LLM engine, no auto-replace.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# PrivateTmp would isolate /tmp from `switchfix` CLI and the Plasma widget.
# All daemon IPC lives in /tmp: llm-history.json, enabled, reload, restart,
# capture-pause, daemon heartbeat. Keep a shared /tmp.
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_UNIX/NETLINK: D-Bus (org.kde.KeyboardLayouts), evdev/uinput netlink.
# AF_INET/6: only for optional LLM API when llm.base_url is set.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
# evdev/uinput need /dev/input and /dev/uinput.
DeviceAllow=/dev/input/event* rw
DeviceAllow=/dev/uinput rw
DevicePolicy=closed
# Config lives in ~/.config/switchfix (read-only is enough for the daemon;
# the Settings GUI writes config as a separate process).
ReadOnlyPaths=%h/.config/switchfix
# Logs must not contain typed text or the API token (see PRIVACY.md).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=switchfix

[Install]
WantedBy=graphical-session.target
