#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""llm-spell — local spell/typo corrector for SwitchFix hybrid layer.

Protocol (JSON lines on stdin/stdout), matches switchfix ProcessCorrector:

    → {"word":"приветт","context":"всем приветт","lang":"ru"}
    ← {"suggestions":["привет"],"is_ok":false,"backend":"t5"}
    ← {"is_ok":true,"backend":"t5"}          # word is fine — veto dict FP

Also accepts plain one-shot:  echo '...' | llm-spell --once
and prints a ready line on startup:  {"ready":true,"backend":"..."}

Backends (auto-picked, override with --backend / LLM_SPELL_BACKEND):
  t5        HuggingFace T5 spell model (default for quality)
  ollama    local Ollama HTTP (qwen2.5:0.5b / llama3.2:1b / …)
  rules     no ML — edit distance + confusables + hunspell (always works)

Models stay ≤300 MB: t5-small-class (~240 MB fp32) or Q4 GGUF via Ollama.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Callable

__version__ = "0.1.0"

# ---------------------------------------------------------------------------
# Shared helpers
# ---------------------------------------------------------------------------

RU_ALPHA = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя"
EN_ALPHA = "abcdefghijklmnopqrstuvwxyz"

# Common one-char confusions (keyboard / phonetic).
CONFUSABLES = {
    "ru": {
        "е": "и", "и": "е", "ё": "о", "о": "ё", "ы": "и", "ь": "ъ", "ъ": "ь",
        "т": "д", "д": "т", "з": "с", "с": "з", "ж": "ш", "ш": "ж",
        "ч": "щ", "щ": "ч", "л": "р", "р": "л", "м": "н", "н": "м",
        "в": "ф", "ф": "в", "к": "х", "г": "к", "б": "п", "п": "б",
        "у": "ю", "ю": "у",
    },
    "en": {
        "e": "i", "i": "e", "a": "e", "o": "a", "s": "c", "c": "s", "k": "c",
        "m": "n", "n": "m", "t": "d", "d": "t", "l": "r", "r": "l",
        "w": "v", "v": "w", "b": "p", "p": "b", "g": "j",
    },
}


def detect_lang(word: str) -> str:
    cyr = sum(1 for c in word if "а" <= c.lower() <= "я" or c.lower() == "ё")
    lat = sum(1 for c in word if c.isascii() and c.isalpha())
    return "ru" if cyr >= lat else "en"


def edit_distance(a: str, b: str) -> int:
    """Damerau-Levenshtein (transposition = 1) — matches how humans type."""
    if a == b:
        return 0
    if not a:
        return len(b)
    if not b:
        return len(a)
    la, lb = len(a), len(b)
    # Full matrix so we can look at i-2/j-2 for transpositions.
    d = [[0] * (lb + 1) for _ in range(la + 1)]
    for i in range(la + 1):
        d[i][0] = i
    for j in range(lb + 1):
        d[0][j] = j
    for i in range(1, la + 1):
        for j in range(1, lb + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            d[i][j] = min(
                d[i - 1][j] + 1,       # delete
                d[i][j - 1] + 1,       # insert
                d[i - 1][j - 1] + cost,  # sub/match
            )
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                d[i][j] = min(d[i][j], d[i - 2][j - 2] + 1)  # transpose
    return d[la][lb]


